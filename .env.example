# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Groq API key - get one free at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Model used for the agent's conversation + tool calling
CLINIC_CHAT_MODEL=llama-3.3-70b-versatile

# Smaller/faster model used only for the safety + intent classifier
CLINIC_CLASSIFIER_MODEL=llama-3.1-8b-instant

# Seconds to wait on a classifier call before we treat it as failed
CLINIC_CLASSIFIER_TIMEOUT=6

# Max tool calls the agent may make in a single turn
CLINIC_MAX_TOOL_CALLS=4
